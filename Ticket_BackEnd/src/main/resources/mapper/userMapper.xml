<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.ticket_backend.mapper.UserMapper">

  <!-- 이메일로 유저 조회-->
  <select id="selectUserByEmail" resultType="com.ssafy.ticket_backend.model.User">
    SELECT *
    FROM users
    WHERE email = #{email}
  </select>
  

</mapper>