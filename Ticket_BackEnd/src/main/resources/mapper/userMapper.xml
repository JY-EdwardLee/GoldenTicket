<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.ticket_backend.mapper.UserMapper">

  <!-- 이메일로 유저 조회-->
  <select id="selectUserByEmail" resultType="com.ssafy.ticket_backend.model.User">
    SELECT *
    FROM users
    WHERE email = #{email}
  </select>

  <!--  private String email;-->
  <!--  private String gender;-->
  <!--  private String userName;-->
  <!--  private String nickName;-->
  <!--  private String birthDate;      // String으로 받고, LocalDate로 변환해도 됨-->
  <!--  private String phoneNumber;-->
  <!--  private String myTeam;-->
  <!--  private String socialProvider; // 예: "naver", "kakao"-->


  <!-- 유저 회원가입 -->
  <insert id="insertUser" parameterType="com.ssafy.ticket_backend.dto.request.UserSignupRequest"
    useGeneratedKeys="true" keyProperty="userId">
    INSERT INTO users (
    email,
    user_name,
    user_role,
    nickname,
    birth_date,
    phone_number,
    my_team,
    social_provider
    ) VALUES (
    #{email},
    #{userName},
    #{userRole},
    #{nickname},
    #{birthDate},
    #{phoneNumber},
    #{myTeam},
    #{socialProvider}
    )
  </insert>

</mapper>